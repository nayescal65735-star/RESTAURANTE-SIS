generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RolUsuario {
  ADMIN
  MESERO
  COCINERO
  CAJERO
}

enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  COMPLETADA
}

enum EstadoMesa {
  DISPONIBLE
  OCUPADA
  RESERVADA
  MANTENIMIENTO
}

enum EstadoPedido {
  PENDIENTE
  EN_PREPARACION
  LISTO
  ENTREGADO
  CANCELADO
}

enum EstadoVenta {
  PENDIENTE
  PAGADA
  ANULADA
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  QR
}

enum TipoMovimientoInventario {
  ENTRADA
  SALIDA
  AJUSTE
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nombre    String
  email     String   @unique
  password  String
  rol       RolUsuario @default(MESERO)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pedidos               Pedido[]
  ventas                Venta[]
  compras               Compra[]
  movimientosInventario MovimientoInventario[]

  @@map("usuarios")
}

model Cliente {
  id        Int      @id @default(autoincrement())
  nombre    String
  telefono  String?
  email     String?
  activo    Boolean  @default(true)
  validado  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservas  Reserva[]
  pedidos   Pedido[]
  ventas    Venta[]

  @@map("clientes")
}

model Mesa {
  id          Int      @id @default(autoincrement())
  numero      Int      @unique
  capacidad   Int
  estado      EstadoMesa @default(DISPONIBLE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reservas    Reserva[]
  pedidos     Pedido[]

  @@map("mesas")
}

model Reserva {
  id          Int      @id @default(autoincrement())
  fecha       DateTime
  cantidad    Int
  estado      EstadoReserva @default(PENDIENTE)
  observacion String?
  clienteId   Int
  mesaId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cliente     Cliente @relation(fields: [clienteId], references: [id])
  mesa        Mesa    @relation(fields: [mesaId], references: [id])

  @@index([fecha])
  @@index([clienteId])
  @@index([mesaId])
  @@map("reservas")
}

model Categoria {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique
  descripcion String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  platos      Plato[]
  inventarios Inventario[]

  @@map("categorias")
}

model Plato {
  id           Int      @id @default(autoincrement())
  nombre       String
  descripcion  String?
  precio       Decimal  @db.Decimal(10, 2)
  disponible   Boolean  @default(true)
  categoriaId  Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  categoria    Categoria @relation(fields: [categoriaId], references: [id])
  detalles     DetallePedido[]

  @@index([categoriaId])
  @@map("platos")
}

model Pedido {
  id          Int      @id @default(autoincrement())
  fecha       DateTime @default(now())
  estado      EstadoPedido @default(PENDIENTE)
  observacion String?
  usuarioId   Int
  clienteId   Int?
  mesaId      Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  usuario               Usuario   @relation(fields: [usuarioId], references: [id])
  cliente               Cliente?  @relation(fields: [clienteId], references: [id])
  mesa                  Mesa?     @relation(fields: [mesaId], references: [id])
  detalles              DetallePedido[]
  venta                 Venta?
  movimientosInventario MovimientoInventario[]

  @@index([usuarioId])
  @@index([clienteId])
  @@index([mesaId])
  @@index([fecha])
  @@map("pedidos")
}

model DetallePedido {
  id          Int      @id @default(autoincrement())
  cantidad    Int
  precio      Decimal  @db.Decimal(10, 2)
  pedidoId    Int
  platoId     Int

  pedido      Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  plato       Plato  @relation(fields: [platoId], references: [id])

  @@index([pedidoId])
  @@index([platoId])
  @@map("detalles_pedido")
}

model Venta {
  id          Int      @id @default(autoincrement())
  total       Decimal  @db.Decimal(10, 2)
  metodoPago  MetodoPago
  estado      EstadoVenta @default(PENDIENTE)
  fecha       DateTime @default(now())
  pedidoId    Int      @unique
  clienteId   Int?
  usuarioId   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pedido      Pedido @relation(fields: [pedidoId], references: [id])
  cliente     Cliente? @relation(fields: [clienteId], references: [id])
  usuario     Usuario @relation(fields: [usuarioId], references: [id])

  @@index([fecha])
  @@index([clienteId])
  @@index([usuarioId])
  @@map("ventas")
}

model Proveedor {
  id          Int      @id @default(autoincrement())
  nombre      String
  contacto    String?
  telefono    String?
  email       String?
  direccion   String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inventarios Inventario[]
  compras     Compra[]

  @@map("proveedores")
}

model Inventario {
  id             Int      @id @default(autoincrement())
  nombre         String
  descripcion    String?
  unidad         String
  stock          Decimal  @db.Decimal(10, 2)
  stockMinimo    Decimal  @db.Decimal(10, 2)
  precioCompra   Decimal  @db.Decimal(10, 2)
  precioVenta    Decimal? @db.Decimal(10, 2)
  activo         Boolean  @default(true)
  proveedorId    Int?
  categoriaId    Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  proveedor      Proveedor? @relation(fields: [proveedorId], references: [id])
  categoria      Categoria? @relation(fields: [categoriaId], references: [id])
  detallesCompra DetalleCompra[]
  movimientos    MovimientoInventario[]

  @@index([proveedorId])
  @@index([categoriaId])
  @@map("inventario")
}

model Compra {
  id          Int      @id @default(autoincrement())
  fecha       DateTime @default(now())
  observacion String?
  total       Decimal  @db.Decimal(10, 2)
  proveedorId Int?
  usuarioId   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  proveedor   Proveedor? @relation(fields: [proveedorId], references: [id])
  usuario     Usuario?   @relation(fields: [usuarioId], references: [id])
  detalles    DetalleCompra[]
  movimientos MovimientoInventario[]

  @@index([proveedorId])
  @@index([usuarioId])
  @@index([fecha])
  @@map("compras")
}

model DetalleCompra {
  id             Int      @id @default(autoincrement())
  compraId       Int
  inventarioId   Int
  cantidad       Decimal  @db.Decimal(10, 2)
  precioUnitario Decimal  @db.Decimal(10, 2)
  subtotal       Decimal  @db.Decimal(10, 2)

  compra         Compra     @relation(fields: [compraId], references: [id], onDelete: Cascade)
  inventario     Inventario @relation(fields: [inventarioId], references: [id])

  @@index([compraId])
  @@index([inventarioId])
  @@map("detalles_compra")
}

model MovimientoInventario {
  id             Int                     @id @default(autoincrement())
  inventarioId   Int
  tipo           TipoMovimientoInventario
  cantidad       Decimal                 @db.Decimal(10, 2)
  stockAnterior  Decimal                 @db.Decimal(10, 2)
  stockPosterior Decimal                 @db.Decimal(10, 2)
  motivo         String?
  fecha          DateTime                @default(now())
  usuarioId      Int?
  compraId       Int?
  pedidoId       Int?
  createdAt      DateTime                @default(now())

  inventario     Inventario @relation(fields: [inventarioId], references: [id])
  usuario        Usuario?   @relation(fields: [usuarioId], references: [id])
  compra         Compra?    @relation(fields: [compraId], references: [id])
  pedido         Pedido?    @relation(fields: [pedidoId], references: [id])

  @@index([inventarioId])
  @@index([usuarioId])
  @@index([compraId])
  @@index([pedidoId])
  @@index([fecha])
  @@map("movimientos_inventario")
}
